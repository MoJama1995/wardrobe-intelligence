# config and encrypted secrets only.

# ── Claude Code ──────────────────────────────────────────────────────
.claude/settings.local.json

# ── OS / editors ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
logs/
*.log
